{
    "name": "@deepseek-ai/dsh-ant-sword-harness",
    "description": "Security-research agent bundle with reverse/CTF skills, workspace rewind, autonomous loop, and plugin-market integration",
    "version": "0.1.0-rc.24",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xiaomayisjh/dsh-ant-sword.git"
    },
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./rewind": {
            "types": "./lib/types/rewind-plugin.d.ts",
            "default": "./lib/rewind-plugin.js"
        },
        "./invariant": {
            "types": "./lib/types/invariant.d.ts",
            "default": "./lib/invariant.js"
        },
        "./client": {
            "types": "./vendor/ui-autograph/lib/types/client/index.d.ts",
            "default": "./vendor/ui-autograph/lib/client.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./ui-autograph": "./vendor/ui-autograph/lib/index.js",
        "./ui-autograph/package.json": "./vendor/ui-autograph/package.json",
        "./package.json": "./package.json"
    },
    "files": [
        "lib/index.js",
        "lib/invariant.js",
        "lib/rewind-plugin.js",
        "lib/types",
        "cordis.patch.yml",
        "scripts/align-dsh-scope.ps1",
        "vendor/ui-autograph",
        "src",
        "skills",
        "preset",
        "kali",
        "docs",
        "RULES.md",
        "RULES_zh.md",
        "README_AI.md",
        "README_EN.md"
    ],
    "license": "MIT",
    "dsh": {
        "client": {
            "inject": [
                "@deepseek-ai/dsh-api-remotes",
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-conversation",
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-ui-settings",
                "@deepseek-ai/dsh-client-ui-renderer",
                "@deepseek-ai/dsh-client-ui-session"
            ],
            "platform": "web"
        },
        "bundle": {
            "patch": [
                "./cordis.patch.yml",
                "./preset/red-team.patch.yml",
                "./preset/red-team-auto.patch.yml"
            ]
        }
    },
    "scripts": {
        "build": "node scripts/build.mjs build",
        "build:bundle": "node scripts/build.mjs bundle",
        "build:types": "node scripts/build.mjs types",
        "typecheck": "node scripts/build.mjs typecheck",
        "test": "vitest run && node --test scripts/*.test.mjs",
        "verify:skills": "node scripts/verify-skills.mjs",
        "test:release-artifacts": "node --test scripts/release-artifacts.test.mjs",
        "pack:check": "node scripts/pack-check.mjs",
        "install:smoke": "node scripts/install-smoke.mjs",
        "release:github": "node scripts/release-github.mjs"
    },
    "dependencies": {
        "@deepseek-ai/cordis": "4.0.4",
        "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
        "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
        "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
        "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.2",
        "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
        "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
        "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
        "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
        "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
        "@deepseek-ai/dsh-session": "0.2.0-rc.2",
        "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
        "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
        "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
        "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
        "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
        "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
        "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
        "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
        "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
        "@deepseek-ai/schemastery": "^3.18.4",
        "dshmarket": "1.66.5",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.4",
        "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
        "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-fs": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.2",
        "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.4",
        "@deepseek-ai/cordis-plugin-include": "1.0.9",
        "@deepseek-ai/cordis-plugin-loader": "1.0.5",
        "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
        "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
        "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
        "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
        "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
        "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
        "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
        "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
        "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
        "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
        "@deepseek-ai/dsh-session": "0.2.0-rc.2",
        "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
        "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
        "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
        "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
        "@testing-library/react": "^16.3.2",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@xyflow/react": "^12.11.3",
        "esbuild": "^0.27.2",
        "js-yaml": "^4.1.0",
        "jsdom": "^30.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "^5.9.3",
        "vitest": "^3.1.1"
    },
    "packageManager": "pnpm@11.7.0"
}
