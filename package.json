{
    "name":  "@deepseek-ai/dsh-ant-sword-harness",
    "description":  "Security-research agent bundle: a bundled reverse/CTF skill pack plus a self-contained workspace snapshot + /rewind capability, composed with the agent-teams and plugin-market bundles",
    "version":  "0.1.0-rc.17",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/xiaomayisjh/dsh-ant-sword.git"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./rewind":  {
                                     "types":  "./lib/types/rewind-plugin.d.ts",
                                     "default":  "./lib/rewind-plugin.js"
                                 },
                    "./invariant":  {
                                        "types":  "./lib/types/invariant.d.ts",
                                        "default":  "./lib/invariant.js"
                                    },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./ui-autograph":  "./vendor/ui-autograph/lib/index.js",
                    "./ui-autograph/package.json":  "./vendor/ui-autograph/package.json",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/invariant.js",
                  "lib/rewind-plugin.js",
                  "lib/types",
                  "cordis.patch.yml",
                  "vendor/ui-autograph",
                  "vendor/mcp-client",
                  "src",
                  "skills",
                  "preset",
                  "kali",
                  "docs",
                  "RULES.md",
                  "RULES_zh.md",
                  "README_AI.md",
                  "README_EN.md"
              ],
    "license":  "MIT",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "scripts":  {
                    "build":  "node scripts/build.mjs build",
                    "build:bundle":  "node scripts/build.mjs bundle",
                    "build:types":  "node scripts/build.mjs types",
                    "typecheck":  "node scripts/build.mjs typecheck",
                    "test":  "vitest run \u0026\u0026 node --test scripts/*.test.mjs",
                    "verify:skills":  "node scripts/verify-skills.mjs",
                    "test:release-artifacts":  "node --test scripts/release-artifacts.test.mjs",
                    "pack:check":  "node scripts/pack-check.mjs",
                    "install:smoke":  "node scripts/install-smoke.mjs",
                    "release:github":  "node scripts/release-github.mjs"
                },
    "dependencies":  {
                         "@deepseek-ai/dsh-home-paths":  "^0.1.0-rc.6",
                         "@deepseek-ai/dsh-mcp-client":  "file:vendor/mcp-client",
                         "@deepseek-ai/dsh-session-projection":  "^0.1.0-rc.6",
                         "@deepseek-ai/dsh-settings":  "^0.1.0-rc.6",
                         "@deepseek-ai/dsh-subprocess":  "^0.1.0-rc.6",
                         "@deepseek-ai/dsh-system-prompt":  "^0.1.0-rc.6",
                         "@deepseek-ai/schemastery":  "^3.18.1",
                         "@nanmicoder/dsh-agent-teams":  "^0.1.4",
                         "dshmarket":  "^1.4.1",
                         "zod":  "^4.4.3"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/dsh-agent":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-commands":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-fs":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-home-paths":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-host-webserver":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-invariants":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-llm":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-session":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-skill":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-storage-domain":  "^0.1.0-rc.6",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "^4.0.1",
                            "@deepseek-ai/dsh-agent":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-api-remotes":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-locale":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-runtime":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-conversation":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-settings":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-client-web-react":  "0.1.0-rc.6",
                            "@deepseek-ai/dsh-commands":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-fs":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-home-paths":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-host-webserver":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-invariants":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-llm":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-session":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-skill":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-storage-domain":  "^0.1.0-rc.6",
                            "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6",
                            "@testing-library/react":  "^16.3.2",
                            "@types/node":  "^24.0.0",
                            "@types/react":  "^19.2.18",
                            "@types/react-dom":  "^19.2.4",
                            "@xyflow/react":  "^12.11.3",
                            "esbuild":  "^0.27.2",
                            "jsdom":  "^30.0.1",
                            "react":  "^19.2.8",
                            "react-dom":  "^19.2.8",
                            "typescript":  "^5.9.3",
                            "vitest":  "^3.1.1"
                        },
    "packageManager":  "pnpm@11.7.0"
}
