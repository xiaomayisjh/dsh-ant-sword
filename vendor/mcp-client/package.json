{
  "name": "@deepseek-ai/dsh-mcp-client",
  "description": "Vendored MCP client bridge for the Ant Sword bundle",
  "version": "0.1.0-rc.14",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
